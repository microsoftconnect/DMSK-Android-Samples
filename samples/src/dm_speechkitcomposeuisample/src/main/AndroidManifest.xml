<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:allowAudioPlaybackCapture="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        tools:targetApi="q">

        <activity
            android:name="com.nuance.dm_speechkit.composeuisample.SpeechKitComposeUISample"
            android:exported="true"
            android:label="Dragon Medical SpeechKit Compose UI Sample">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.nuance.dm_speechkit.composeuisample.ComposeUIReportsActivity"
            android:exported="false" />

        <activity
            android:name="com.nuance.dm_speechkit.composeuisample.reports.ComposeUIAndroidViewBindingActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name="com.nuance.dm_speechkit.composeuisample.reports.ComposeUIAndroidViewWrapperActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name="com.nuance.dm_speechkit.composeuisample.reports.PureComposeCustomVCReportActivity"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />
    </application>

    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
</manifest>
